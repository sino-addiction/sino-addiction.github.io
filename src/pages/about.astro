---
import BaseLayout from "../layouts/BaseLayout.astro";
import Hero from "../components/Hero.astro";
import SectionHeading from "../components/SectionHeading.astro";
import NetworkMap from "../components/NetworkMap.astro";
import { siteData } from "../data/site";
import { requirePage } from "../lib/content";

const page = await requirePage("about");

const centerMembers = [
  {
    name: "袁逖飞",
    badge: "中心站点",
    institution: "上海交通大学心理学院",
    title: "学术委员会主席",
    homepage: "https://psychology.sjtu.edu.cn/tsml/211.html",
    description:
      "负责协作平台的学术定位、合作拓展、学术把关和重大研究方向指导，为平台建设与长期发展提供学术支持。",
  },
  {
    name: "曹智鹏",
    badge: "中心站点",
    institution: "上海市徐汇区精神卫生中心",
    title: "项目执行负责人",
    description:
      "负责日常协调、数据联络、项目推进、网站维护与执行工作，推动中心站点信息整理、协作流程对接和项目落地。",
  },
];
---

<BaseLayout title={page.data.title} description={page.data.description}>
  <Hero {...page.data.hero} compact={true} />

  <!-- Stats + Network Map -->
  <section class="relative pt-6 pb-10 md:pt-8 md:pb-12 bg-surface-alt/35">
    <div class="page-wrap">
      <div class="w-full max-w-4xl mx-auto mb-8 md:mb-10 text-center">
        <SectionHeading
          title="多中心协作版图"
          description="当前版图仅用于展示 SANI 拟建设的多中心协作网络，具体参与站点与协作关系以后续确认信息为准，并将持续更新。"
          center={true}
        />
      </div>

      <div class="grid gap-8 xl:gap-10 lg:grid-cols-[minmax(300px,360px)_minmax(0,1fr)] lg:items-center">
        <aside class="rounded-[32px] border border-border/60 bg-[#f4f7f3]/70 p-4 md:p-5 shadow-[0_14px_40px_rgba(16,33,50,0.04)] backdrop-blur-sm lg:self-center">
          <div class="grid gap-4 sm:grid-cols-3 lg:grid-cols-1">
          {siteData.homepage.stats.map((stat) => (
            <article class="rounded-[24px] border border-white/70 bg-white/58 p-6 md:p-7 shadow-[0_10px_24px_rgba(16,33,50,0.04)] backdrop-blur-sm">
              <span class="text-[13px] font-[750] text-text-muted uppercase tracking-[0.18em] mb-3 flex items-center gap-3">
                <span class="relative w-3 h-3 flex items-center justify-center">
                  <span class="absolute inset-0 bg-accent/25 rounded-full animate-ping"></span>
                  <span class="relative w-2 h-2 bg-accent rounded-full"></span>
                </span>
                {stat.label}
              </span>
              <span class="block text-[44px] md:text-[52px] font-serif font-bold text-ink-deep leading-none tracking-tighter">
                {stat.value}
              </span>
              <p class="mt-3 text-[13px] md:text-[14px] text-text-muted/85 leading-relaxed">
                {stat.note}
              </p>
            </article>
          ))}
          </div>
        </aside>

        <div class="w-full max-w-[860px] justify-self-end">
          <NetworkMap variant="home" />
        </div>
      </div>
    </div>
  </section>

  <!-- 中心站点成员 -->
  <section class="page-wrap section-shell pt-0">
    <SectionHeading
      eyebrow="Collaboration Network"
      title="中心站点"
      description="当前仅展示已确认的中心站点人员与职责分工，相关信息将随平台建设和协作确认持续更新。"
      center={true}
    />
    <div class="mt-12 mx-auto grid max-w-5xl gap-6 md:grid-cols-2">
      {centerMembers.map((member) => (
        <article class="surface-card flex h-full flex-col border-t-4 border-t-accent p-8 md:p-10">
          <span class="eyebrow mb-5 inline-flex w-fit whitespace-nowrap ring-1 ring-inset ring-accent/10">{member.badge}</span>
          <h3 class="card-title">{member.name}</h3>
          <p class="mt-3 text-[14px] font-semibold text-accent">{member.title}</p>
          <p class="mt-4 text-[15px] leading-relaxed text-text-secondary">
            {member.institution}
          </p>
          <p class="mt-5 text-[15px] leading-relaxed text-text-secondary">
            {member.description}
          </p>
          {member.homepage && (
            <a
              class="mt-6 inline-flex w-fit rounded-full border border-accent/25 px-4 py-2 text-[14px] font-semibold text-accent transition hover:border-accent hover:bg-accent-soft"
              href={member.homepage}
              target="_blank"
              rel="noopener noreferrer"
            >
              个人主页
            </a>
          )}
        </article>
      ))}
    </div>
  </section>

  <!-- Participating Institutions -->
  <section class="page-wrap section-shell pt-0">
    <SectionHeading
      eyebrow="Growing Network"
      title="参与机构与研究团队"
      center={true}
    />
    <div class="mt-10 mx-auto max-w-3xl rounded-[28px] border border-border/70 bg-surface-alt/65 p-8 text-center md:p-10">
      <p class="text-[16px] leading-[1.9] text-text-secondary">
        SANI 正在持续联系和确认更多参与机构、临床站点与研究团队。相关名单将在获得确认后逐步更新。
      </p>
    </div>
  </section>
</BaseLayout>
